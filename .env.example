# ===========================================
# ReliefForge SaaS - Environment Variables
# ===========================================

# Database
DATABASE_URL="postgresql://user:***@localhost:5432/reliefforge?schema=public"

# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R...***
R2_BUCKET_NAME="reliefforge"

# NextAuth
NEXTAUTH_SECRET=***
N...n

# Stripe
STRIPE_SECRET_KEY=***
S...n
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (Email)
RESEND_API_KEY=*** OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=***
G...***
